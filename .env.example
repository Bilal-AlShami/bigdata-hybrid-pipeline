# ==============================================================================
# إعدادات بيئة العمل وقاعدة البيانات - المشروع النهائي (Big Data Phase 2)
# ==============================================================================

# عنوان الاتصال بقاعدة بيانات MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=ecommerce_db

# أسماء المجموعات الرئيسية
COLLECTION_RAW=orders_raw
COLLECTION_VALIDATED=orders_validated
COLLECTION_QUARANTINE=orders_quarantine
COLLECTION_CHECKPOINTS=elt_checkpoints
COLLECTION_JOB_LOGS=job_logs

# أسماء مجموعات العروض المادية
COLLECTION_MV_DAILY_SALES=daily_sales_summary
COLLECTION_MV_TOP_PRODUCTS=top_products_summary

# الحد الفاصل لتوجيه الملفات (بالميجابايت)
SMALL_FILE_THRESHOLD_MB=200

# إعدادات خادم FastAPI الموحد
API_HOST=127.0.0.1
API_PORT=8000
